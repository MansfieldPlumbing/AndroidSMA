<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0-android</TargetFramework>
    <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <ApplicationId>dev.mansfieldplumbing.androidsma</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <PublishTrimmed>false</PublishTrimmed>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <AndroidNativeLibrary Remove="**\*.so" />
    <Compile Include="MainActivity.cs" />
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.7.0-preview.2">
      <ExcludeAssets>native</ExcludeAssets>
    </PackageReference>
    <AndroidNativeLibrary Include="native\arm64-v8a\libpsl-native.so"
                          Link="arm64-v8a\libpsl-native.so"
                          Condition="'$(RuntimeIdentifier)' == 'android-arm64'" />
    <AndroidNativeLibrary Include="native\armeabi-v7a\libpsl-native.so"
                          Link="armeabi-v7a\libpsl-native.so"
                          Condition="'$(RuntimeIdentifier)' == 'android-arm'" />
    <AndroidResource Include="src\Android\Resources\**\*"
                     Link="Resources\%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="src\Boot\Recovery.ps1" Link="Recovery.ps1" />
  </ItemGroup>
  <ItemGroup>
    <!--
      EXPERIMENTS ARE SOURCE ARTIFACTS ONLY.
      NOTHING UNDER experiments\ MAY PARTICIPATE IN THE PRODUCTION BUILD.
    -->
    <Compile Remove="experiments\**\*.cs" />
    <AndroidResource Remove="experiments\**\*" />
    <AndroidAsset Remove="experiments\**\*" />
    <None Update="experiments\**\*" />
  </ItemGroup>
</Project>
